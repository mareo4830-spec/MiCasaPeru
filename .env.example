# Configuración de Supabase (Reemplaza con los valores de tu proyecto en https://supabase.com)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-public-key-aqui

# Configuración de Telegram Bot (Opcional - Notificaciones de Reservas)
VITE_TELEGRAM_BOT_TOKEN=tu-bot-token-de-telegram-aqui
VITE_TELEGRAM_CHAT_ID=tu-chat-id-de-telegram-aqui

